{
  "name": "@nostro-labs/server",
  "version": "0.1.0",
  "description": "An HTTP API over a nostro store, with signed webhooks and an OpenAPI document.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostro-labs/nostro.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/nostro-labs/nostro/tree/main/packages/server",
  "bugs": {
    "url": "https://github.com/nostro-labs/nostro/issues"
  },
  "keywords": [
    "stellar",
    "reconciliation",
    "payments",
    "api",
    "webhooks"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  },
  "peerDependencies": {
    "@nostro-labs/nostro": "workspace:^"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nostro-labs/nostro": "workspace:*",
    "@vitest/coverage-v8": "^2.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "nostro-testkit": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
