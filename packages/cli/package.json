{
  "name": "@nostro-labs/cli",
  "version": "0.1.0",
  "description": "The nostro command line: ingest Stellar payments, reconcile them, check the books, export the journal, and serve the API.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "nostro": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostro-labs/nostro.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/nostro-labs/nostro/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/nostro-labs/nostro/issues"
  },
  "keywords": [
    "stellar",
    "reconciliation",
    "accounting",
    "payments",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@nostro-labs/nostro": "workspace:^",
    "@nostro-labs/server": "workspace:^",
    "@nostro-labs/store-postgres": "workspace:^",
    "@nostro-labs/store-sqlite": "workspace:^"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "better-sqlite3": "^12.11.1",
    "nostro-testkit": "workspace:*",
    "pg": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
